# CodeGuard frontend — environment variables.
# Copy to `.env` in this folder (git-ignored) and adjust.
# Vite only exposes `VITE_*` variables to the browser bundle:
# NEVER put secrets (database passwords, tokens) in this file.

# Base URL of the CodeGuard backend API, INCLUDING the /api/v1 prefix.
# The client normalises this value, so `http://localhost:8000` and
# `http://localhost:8000/api/v1` both resolve to exactly one /api/v1 prefix.
#
# Local backend (default):  http://localhost:8000/api/v1
#
# Remote backend / Replit:  a frontend hosted on Replit cannot reach
#   http://localhost:8000 on your machine. Use a publicly reachable backend URL
#   or a tunnel (e.g. ngrok/cloudflared) and set that URL here.
#   The backend CORS allowlist (`CORS_ORIGINS` in the backend .env) must include
#   the frontend origin (default: http://localhost:3000, http://localhost:5173,
#   http://localhost:4173).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Read by vite.config.ts from the process environment (not via import.meta.env).
# Set them in the shell before starting the dev server — see INTEGRATION_STATUS.md.
#   Windows PowerShell:  $env:PORT='5173'; $env:BASE_PATH='/'; pnpm --filter codeguard dev
#   bash/sh:             PORT=5173 BASE_PATH=/ pnpm --filter codeguard dev
PORT=5173
BASE_PATH=/
