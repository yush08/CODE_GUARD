# ---------------------------------------------------------------------------
# CodeGuard backend configuration — COPY THIS FILE TO `.env` AND EDIT IT.
#   copy .env.example .env
# Then replace YOUR_PASSWORD below with your real PostgreSQL 17 password.
# NEVER commit `.env` (it is in .gitignore). NEVER put real credentials here.
# ---------------------------------------------------------------------------

APP_NAME=CodeGuard
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

# PostgreSQL 17 — database `codeguard` on localhost:5432, user `postgres`.
# The backend will NOT connect (and will report DATABASE_UNCONFIGURED) while
# the password is still the placeholder YOUR_PASSWORD.
DATABASE_URL=postgresql+psycopg://postgres:2108@localhost:5432/codeguard

# Allowed browser origins for the separately developed frontend, comma separated.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173

# --- Execution sandbox -----------------------------------------------------
SANDBOX_ROOT=./sandbox

# --- Server-side hard limits ----------------------------------------------
MAX_SOURCE_SIZE_BYTES=100000
MAX_OUTPUT_SIZE_BYTES=1048576
MAX_COMPILATION_SECONDS=15

# Defaults used when a problem does not define its own limits.
DEFAULT_EXECUTION_TIMEOUT_SECONDS=3
DEFAULT_MEMORY_LIMIT_MB=128
DEFAULT_ACTIVE_PROCESS_LIMIT=10

# Hard upper bounds accepted for per-problem limits (validation rejects more).
MAX_ALLOWED_TIME_LIMIT_MS=30000
MAX_ALLOWED_MEMORY_LIMIT_MB=1024
MAX_ALLOWED_PROCESS_LIMIT=64
MAX_ALLOWED_TEST_CASES=50

# --- Concurrency / queue ---------------------------------------------------
MAX_CONCURRENT_EXECUTIONS=2
MAX_QUEUED_JOBS=50
RUN_WAIT_TIMEOUT_SECONDS=30
WORKSPACE_CLEANUP_TIMEOUT_SECONDS=10

# --- Compiler detection ----------------------------------------------------
# Leave empty to auto-detect `gcc` / `g++` on PATH. Set an absolute path to
# force a specific compiler, e.g. C:\MinGW\bin\gcc.exe
COMPILER_C_PATH=
COMPILER_CPP_PATH=
COMPILER_C_FLAGS=-O2 -std=c11
COMPILER_CPP_FLAGS=-O2 -std=c++14

# --- Database probe --------------------------------------------------------
DB_PROBE_TIMEOUT_SECONDS=3
DB_PROBE_TTL_SECONDS=30

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO

# --- Sequence rules override (optional) ------------------------------------
# JSON file with custom rules:
# [{"rule_id": "...", "pattern": ["PROCESS_START", "PROCESS_EXIT"],
#   "risk_level": "LOW|MEDIUM|HIGH", "explanation": "...", "creates_alert": true}]
SEQUENCE_RULES_PATH=

# --- Access model ----------------------------------------------------------
# local_dev = NO authentication is enforced; server must stay on 127.0.0.1.
# The API structure is ready for real authentication to be added later.
AUTH_MODE=local_dev
# Optional header a client may send to scope trust history on this machine.
WORKSPACE_LABEL_HEADER=X-Workspace-Label
